NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_FAUCET_ADDRESS=
# Verified settlement game; never substitute the token or faucet address.
SEPOLIA_GAME_ECONOMY_ADDRESS=
SEPOLIA_GAME_DEPLOYMENT_BLOCK=
NEXT_PUBLIC_GAME_GATEWAY_ADDRESS=
NEXT_PUBLIC_REWARD_ADDRESS=
NEXT_PUBLIC_DEPLOYMENT_BLOCK=
APP_ORIGIN=
# Server-only immutable Supabase user ID; empty disables all developer tools.
DEVELOPER_USER_ID=
# Restricted external signer; no private-key environment fallback is supported.
REWARD_SIGNER_ADDRESS=
SETTLEMENT_SIGNER_URL=
SETTLEMENT_SIGNER_TOKEN=
# Server-only. Development plus the exact DEVELOPER_USER_ID is required.
# Only used by the local owner contract-activation tool, never player access.
GLOW_ACCEPTANCE_ENABLED=
# Independent private game-only recovery storage; never use NEXT_PUBLIC_ keys.
GAME_RECOVERY_URL=
GAME_RECOVERY_SECRET=
GAME_RECOVERY_KEY=
GAME_RECOVERY_STREAM=
REWARDS_ENABLED=
ETHERSCAN_API_KEY=
# Optional licensed authoring installation; not needed by players.
RPG_MZ_PATH=
