{
  "name": "mosslight-ecosystem",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace @mosslight/web",
    "launcher:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-launcher.ps1",
    "launcher:check": "node scripts/launcher/start.mjs --check",
    "launcher:test": "npm run launcher:build && node --test tests/launcher/launcher.test.mjs",
    "build": "npm run build --workspace @mosslight/web",
    "start": "npm run start --workspace @mosslight/web",
    "typecheck": "npm run typecheck --workspace @mosslight/web",
    "typecheck:signer": "tsc --project supabase/functions/tsconfig.json",
    "lint": "eslint apps/web/src tests scripts game/rules game/plugins game/scripts supabase/functions",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:offline": "playwright test tests/browser/registration.spec.ts tests/browser/account-privacy.spec.ts tests/browser/companion.spec.ts tests/browser/package.spec.ts tests/browser/game-deployment.spec.ts tests/browser/paid-entry.spec.ts tests/browser/paid-npc.spec.ts tests/browser/game-fullscreen.spec.ts tests/browser/game-progression.spec.ts tests/browser/npc-follow.spec.ts tests/browser/supply.spec.ts",
    "test:hosted": "node tests/hosted/auth.mjs",
    "test:staging-config": "node tests/hosted/auth-configuration.mjs",
    "test:account": "node tests/hosted/account.mjs",
    "test:production": "node scripts/test-production.mjs",
    "test:all": "node scripts/check-all.mjs",
    "test:offline": "node scripts/check-all.mjs --offline",
    "rpc:check": "node scripts/check-rpc.mjs",
    "database:review": "node scripts/review-database-upgrade.mjs",
    "database:backup": "node scripts/hosted-backup.mjs",
    "database:restore-rehearse": "node scripts/rehearse-hosted-backup.mjs",
    "database:backup-test": "vitest run tests/server/hosted-backup.test.ts --reporter=default --reporter=json --outputFile=test-results/native-backup/report.json",
    "database:rehearse": "vitest run tests/server/migration-upgrade.test.ts --reporter=default --reporter=json --outputFile=test-results/database-upgrade/report.json",
    "contracts:build": "node scripts/forge.mjs build",
    "contracts:test": "node scripts/forge.mjs test -vvv",
    "contracts:format": "node scripts/forge.mjs fmt",
    "contracts:format:check": "node scripts/forge.mjs fmt --check",
    "contracts:coverage": "node scripts/forge.mjs coverage",
    "game:build": "node game/scripts/build.mjs",
    "game:maps": "node game/scripts/maps-only.mjs",
    "game:rules": "node game/scripts/rules.mjs",
    "game:plugins": "node game/scripts/plugins.mjs",
    "game:verify": "node game/scripts/verify.mjs",
    "game:sync": "node game/scripts/sync.mjs",
    "release:package": "node scripts/release-package.mjs",
    "game:balance": "vitest run tests/game/balance.test.ts",
    "recovery:drill": "vitest run tests/server/recovery.test.ts tests/server/paid-journey.test.ts --reporter=default --reporter=json --outputFile=test-results/recovery/report.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.10",
    "@openzeppelin/contracts": "5.6.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/deno": "2.7.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "html-validate": "11.16.4",
    "jsqr": "^1.4.0",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "optionalDependencies": {
    "@foundry-rs/forge-win32-amd64": "1.7.1"
  }
}
